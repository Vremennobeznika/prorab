+/* Проект и диалог — основное рабочее пространство. */
+.container { max-width: 1600px; }
+.workbench { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 28px; align-items: start; }
+.project-sidebar { border-right: 1px solid var(--soft-border); padding-right: 20px; position: sticky; top: 12px; max-height: 88vh; overflow: auto; }
+.project-sidebar h2:first-child, .dialogue-main > h2 { margin-top: 0; }
+.project-sidebar .btn { width: 100%; margin: 4px 0; padding: 8px; }
+.project-sidebar input { font-size: 13px; }
+.session-button { text-align: left; overflow-wrap: anywhere; }
+.session-button[aria-current="true"] { border-width: 3px; }
+.conversation { display: grid; gap: 14px; margin-bottom: 20px; }
+.chat-message { padding: 14px 18px; border: 1px solid var(--soft-border); border-radius: 14px; overflow-wrap: anywhere; white-space: pre-wrap; }
+.chat-message.user { background: var(--block); margin-left: 8%; }
+.chat-message.assistant { margin-right: 4%; }
+.chat-message h3 { margin: 0 0 8px; font-size: 14px; color: var(--text-soft); }
+.chat-message p { margin: 0; }
+#session-plan li { padding: 6px 0; overflow-wrap: anywhere; }
+#session-plan h3 { margin: 0; }
+#run-form { position: relative; }
+.run-archive { margin-top: 20px; }
+.run-archive .list { margin-top: 12px; }
+summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-weight: 600; }
+@media (max-width: 820px) {
+ .workbench { grid-template-columns: 1fr; gap: 20px; }
+ .project-sidebar { position: static; border-right: 0; border-bottom: 1px solid var(--soft-border); padding: 0 0 16px; max-height: none; }
+ #session-list { display: flex; overflow-x: auto; }
+ #session-list .btn { min-width: 150px; max-width: 220px; flex-shrink: 0; }
+}
