# Скопируйте этот файл под именем .env и впишите свои ключи.
# Файл .env нельзя выкладывать в интернет (он уже внесён в .gitignore).
# Ключи нужны только тем провайдерам, которые вы включили в config/providers.json.

# GigaChat: «Ключ авторизации» из личного кабинета Studio (developers.sber.ru)
GIGACHAT_AUTH_KEY=

# Z.ai (модели GLM-Flash): ключ с платформы Z.ai API
ZAI_API_KEY=
